# Copie este arquivo para .env e preencha com os seus valores.
# O .env está no .gitignore e NUNCA deve ser enviado para o GitHub.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskdb
DB_USER=taskapi
DB_PASSWORD=defina-uma-senha-forte

# Gere um valor aleatório com: openssl rand -base64 48
JWT_SECRET=cole-aqui-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION=1h
